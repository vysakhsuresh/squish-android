<resources>

    <!--
      The launch theme IS the animation. Android 12+ always draws a system splash
      when an app cold-starts, so rather than showing that and then a second
      in-app animation, the squish bounce is installed as the system splash's
      animated icon. One animation, then the app.
    -->
    <style name="Theme.Squish.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/squish_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/squish_splash_anim</item>
        <item name="windowSplashScreenAnimationDuration">650</item>
        <item name="postSplashScreenTheme">@style/Theme.Squish</item>
    </style>

    <style name="Theme.Squish" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/squish_background</item>
        <item name="android:statusBarColor">@color/squish_background</item>
        <item name="android:navigationBarColor">@color/squish_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

</resources>
