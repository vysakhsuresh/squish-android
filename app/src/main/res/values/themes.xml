<resources>

    <!--
      One entrance, not two. This is the only intro the app has: the mark squashes
      into place on the brand ground and the dashboard is already behind it. The app
      used to play this *and* a second in-app splash showing the same artwork, which
      is why a cold start looked like it was introducing itself twice.
    -->
    <style name="Theme.Squish.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/squish_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/squish_splash</item>
        <item name="windowSplashScreenAnimationDuration">520</item>
        <item name="postSplashScreenTheme">@style/Theme.Squish</item>
    </style>

    <style name="Theme.Squish" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/squish_background</item>
        <item name="android:statusBarColor">@color/squish_background</item>
        <item name="android:navigationBarColor">@color/squish_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

</resources>
