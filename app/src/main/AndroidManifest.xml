<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The progress notification an export shows, asked for when Render is
         first pressed; refused, the export runs without one. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Online features only (online/Online.kt): free music and fonts, fetched
         after the person turns them on. Every request goes through Online.get,
         which refuses while the switch is off. Nothing uploads a video. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- An export runs in a foreground service (ExportService) so the process
         is not killed under a locked screen. The type each release wants is
         declared: media processing on Android 15, data sync before it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- A voiceover is taken over the timeline from the editor. Asked for when
         Record is first pressed, never before. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The in-app camera (EDGE_PLAN G5). Not required: a phone with no camera still installs. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- The music browser lists songs already on the phone. Read-only, and only
         asked for when that tab is opened. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- The app's own media library (MediaLibrarySheet) reads the phone's
         photos and videos out of MediaStore, because the system photo picker
         shows a curated subset that left out videos a person had just shot.
         Read-only; asked for the first time the library is opened. The
         visual-user-selected one is what Android 14's "Select photos" grants,
         and must be declared or that answer reads as a refusal. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Reading a line aloud binds the phone's text-to-speech engine, which
         since Android 11 is invisible to an app that has not declared it wants
         one: without this, TextToSpeech reports no engine on every phone. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".SquishApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Squish">

        <!-- Lets `am profile` sample a release build from the shell, which is
             the only way to see where a *release* frame's time goes: a debug
             build of Compose runs the editor three times slower and lies about
             what is heavy. Shell only; nothing on the phone but adb can use it. -->
        <profileable android:shell="true" />

        <!-- One task, one copy: "Open with" while Squish is running reaches the
             running copy through onNewIntent instead of stacking a second one
             with its own editor. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Squish.Starting"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open with" and "Share" from a file manager or another app. That is
                 where films and downloads are - an MKV in Downloads often never
                 reaches the photo picker's recent grid. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- The two schemes spelled out. A data element with only a
                     mimeType already matches content: and file: and nothing
                     else, so this changes no matching - it says so, which is
                     what lint's AppLinkUrlError was asking for, and it makes
                     plain that a remote video URL was never something this
                     filter offered to open. -->
                <!-- One attribute to a tag: Android unions every data element's
                     attributes anyway, so a tag carrying both reads as if the
                     pair were tied together when it is not. -->
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/ogg" />
                <data android:mimeType="application/mxf" />
                <data android:mimeType="application/vnd.rn-realmedia" />
                <data android:mimeType="application/vnd.rn-realmedia-vbr" />
                <data android:mimeType="application/x-matroska" />
            </intent-filter>
            <intent-filter>
                <!-- No scheme here, and none wanted: a SEND carries its URI in
                     an extra and is matched on the MIME type alone. -->
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/ogg" />
                <data android:mimeType="application/mxf" />
                <data android:mimeType="application/vnd.rn-realmedia" />
                <data android:mimeType="application/vnd.rn-realmedia-vbr" />
                <data android:mimeType="application/x-matroska" />
            </intent-filter>
        </activity>

        <service
            android:name=".media.ExportService"
            android:exported="false"
            android:foregroundServiceType="mediaProcessing|dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- MediaPipe brings Google's datatransport, which sends usage logs
             once the app may use the network. Removed: with online features on,
             the network is for what the person asked for and nothing else. -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:node="remove" />
        <service
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.JobInfoSchedulerService"
            tools:node="remove" />
        <receiver
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.AlarmManagerSchedulerBroadcastReceiver"
            tools:node="remove" />
    </application>
</manifest>
