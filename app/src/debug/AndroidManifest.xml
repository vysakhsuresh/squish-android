<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the media self-test (debug/AvSelfTestActivity.kt). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="com.squish.app.debug.AvSelfTestActivity"
            android:exported="true"
            android:label="Squish media self-test" />
        <!-- A/V sync read off a file (debug/SyncProbeActivity.kt, EDGE_PLAN B3). -->
        <activity
            android:name="com.squish.app.debug.SyncProbeActivity"
            android:exported="true"
            android:label="Squish sync probe" />
        <!-- Whisper run on a file (debug/WhisperProbeActivity.kt, EDGE_PLAN E1). -->
        <activity
            android:name="com.squish.app.debug.WhisperProbeActivity"
            android:exported="true"
            android:label="Squish whisper probe" />
        <!-- A downloaded voice made to speak into a file (debug/VoiceProbeActivity.kt, EDGE_PLAN E5). -->
        <activity
            android:name="com.squish.app.debug.VoiceProbeActivity"
            android:exported="true"
            android:label="Squish voice probe" />
        <!-- Sound levels read off a file (debug/LevelProbeActivity.kt, EDGE_PLAN G2). -->
        <activity
            android:name="com.squish.app.debug.LevelProbeActivity"
            android:exported="true"
            android:label="Squish level probe" />
        <!-- Voice only / Remove voice run on a file and measured (debug/VoiceSplitProbeActivity.kt, EDGE_PLAN G3). -->
        <activity
            android:name="com.squish.app.debug.VoiceSplitProbeActivity"
            android:exported="true"
            android:showWhenLocked="true"
            android:label="Squish voice split probe" />
        <!-- What MagicTouch hands back for a tap (debug/MagicProbeActivity.kt, EDGE_PLAN F7). -->
        <activity
            android:name="com.squish.app.debug.MagicProbeActivity"
            android:exported="true"
            android:label="Squish MagicTouch probe" />
    </application>
</manifest>
