*.iml
.gradle
/local.properties
# Ignore the IDE's own state, but keep the shared spelling dictionary: the words
# in it are the vocabulary of the thing being built - playhead, luma, muxing,
# keyframe - and without it every developer sees the same few hundred fake typos.
# The glob has to be /.idea/* rather than /.idea, because git will not look
# inside an ignored directory to honour a negation underneath it.
/.idea/*
!/.idea/dictionaries
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties
/app/build
/app/release
*.apk
*.aab
# Kotlin 2.x Gradle plugin session and error logs.
/.kotlin

# Local agent state and the worktrees parallel sessions build in.
/.claude/

# A hunting agent's scratch file. The sweeps write throwaway probes into
# tools/jvm to read a function's behaviour - printlns, no assertions - and they
# were landing in commits. A real suite is named in run.sh and run_desktop.sh,
# which RunnerChecks holds it to; anything here matching these is not one.
/tools/jvm/*Probe.kt
/tools/jvm/ZProbe*.kt
/tools/jvm/ProbeChecks.kt
